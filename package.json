{
  "name": "action-tools",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/generate-widget-client.mjs && node scripts/run-framework.mjs dev",
    "build": "node scripts/build-all.mjs",
    "start": "node dist/server/index.mjs",
    "render:runtime-config": "node scripts/render-runtime-config.mjs",
    "lint": "node scripts/generate-widget-client.mjs && eslint . --max-warnings=0",
    "db:generate": "drizzle-kit generate",
    "test": "node scripts/generate-widget-client.mjs && node scripts/testing/run-tests.mjs",
    "typecheck": "node scripts/generate-widget-client.mjs && tsc --noEmit",
    "test:storage": "node scripts/testing/run-tests.mjs adapters",
    "test:ui": "node scripts/generate-widget-client.mjs && node scripts/testing/run-tests.mjs ui",
    "db:migrate:local": "node dist/server/admin.mjs migrate",
    "test:domain": "node scripts/testing/run-tests.mjs domain",
    "test:application": "node scripts/testing/run-tests.mjs application",
    "test:harness": "node scripts/testing/run-tests.mjs harness",
    "test:coverage": "node scripts/testing/run-tests.mjs --coverage",
    "check": "node scripts/check.mjs",
    "test:ui:built": "node scripts/testing/smoke-built-widget.mjs",
    "start:local-mcp": "node scripts/start-local-mcp.mjs",
    "test:postgres": "node scripts/testing/run-tests.mjs postgres",
    "db:admin": "node dist/server/admin.mjs",
    "test:node:built": "node --import ./scripts/testing/register-loader.mjs scripts/testing/verify-node-built.mjs"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "embedded-postgres": "17.10.0-beta.17",
    "embla-carousel-react": "^8.6.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "input-otp": "^1.4.2",
    "jsdom": "26.1.0",
    "json-rpc-2.0": "1.7.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "raw-body": "3.0.2",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vaul": "^1.1.2",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
